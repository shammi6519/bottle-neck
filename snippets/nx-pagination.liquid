{% if paginate.pages > 1 %}
  {% assign current_page_string = paginate.current_page | append: '' %}
  <nav class="nxc-pagination" aria-label="Pagination">
    {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Previous page">{% render 'az-icon', name: 'chevron-left' %}</a>{% endif %}
    {% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% else %}<span{% if part.title == current_page_string %} aria-current="page"{% endif %}>{{ part.title }}</span>{% endif %}{% endfor %}
    {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Next page">{% render 'az-icon', name: 'chevron-right' %}</a>{% endif %}
  </nav>
{% endif %}
