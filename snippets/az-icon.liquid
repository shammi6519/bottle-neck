{% when 'check' %}<circle cx="12" cy="12" r="10" fill="currentColor" stroke="none"/><path d="m7.5 12.3 3 3 6-6.5" stroke="white" stroke-width="2"/>
{% when 'play' %}<circle cx="12" cy="12" r="10" fill="white" stroke="none"/><path d="m10 8 6 4-6 4V8Z" fill="currentColor" stroke="none"/>
{% when 'mountain' %}<path d="m2 20 7-12 4 6 2-3 7 9H2Z"/><path d="m7.3 11 2.2 2 1.3-1.2"/>
{% when 'laptop' %}<rect x="5" y="4" width="14" height="11" rx="1"/><path d="M2.5 19h19l-2.5-4H5l-2.5 4Z"/>
