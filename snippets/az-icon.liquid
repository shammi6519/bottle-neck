{% when 'search' %}<circle cx="11" cy="11" r="6.7"/><path d="m16 16 4 4"/>
{% when 'user' %}<circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c.5-4.2 3.2-6.2 7.5-6.2s7 2 7.5 6.2Z"/>
{% when 'cart' %}<path d="M3 4h2l2.2 11h10.7l2-8H6"/><circle cx="9" cy="19" r="1"/><circle cx="17" cy="19" r="1"/>
