{% when 'flame' %}<path d="M13.5 2.8c.6 4-2.8 5-2 8.2 1-1.3 2.2-2 3.2-3.4 2.1 2.1 3.3 4.5 3.3 7a6 6 0 0 1-12 0c0-3.8 2.2-6.5 5.4-9.5.1 2.2.4 3.5 1 4.4.4-2.4.8-4.6 1.1-6.7Z"/>
