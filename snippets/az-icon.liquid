{% liquid
  assign icon_name = name | default: 'leaf'
  assign icon_class = class | default: ''
%}
<svg class="az-icon {{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
