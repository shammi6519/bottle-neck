{% if request.page_type == 'index' %}
<footer class="nx-footer" id="nx-footer">
  <div class="nx-footer__newsletter"><div class="nx-container nx-footer__newsletter-inner"><div><h2>Join Our Newsletter</h2><p>Get the latest updates, exclusive offers, and more.</p></div>
    {% form 'customer', class: 'nx-newsletter' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="nx-newsletter-email">Email address</label>
      <input id="nx-newsletter-email" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Enter your email address" autocomplete="email" required>
      <button type="submit">Subscribe</button>
      {% if form.posted_successfully? %}<p class="nx-newsletter__message">Thanks for subscribing.</p>{% endif %}
      {% if form.errors %}<p class="nx-newsletter__message">{{ form.errors | default_errors }}</p>{% endif %}
    {% endform %}
  </div></div>
  <div class="nx-container nx-footer__main"><div class="nx-footer__identity"><a href="{{ routes.root_url }}">{{ section.settings.home_brand | escape }}</a><small>© {{ 'now' | date: '%Y' }} {{ section.settings.home_brand | escape }}. All rights reserved.</small></div>
    <div><h3>Shop</h3><a href="{{ routes.all_products_collection_url }}">All Products</a><a href="#categories">Smart Watches</a><a href="#categories">Earbuds</a><a href="#categories">Accessories</a><a href="#categories">Lifestyle</a></div>
    <div><h3>Information</h3>{% if section.settings.information_menu != blank %}{% for link in section.settings.information_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}{% if pages['about-us'] != blank %}<a href="{{ pages['about-us'].url }}">About Us</a>{% endif %}{% if pages['contact'] != blank %}<a href="{{ pages['contact'].url }}">Contact</a>{% endif %}{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping Policy</a>{% endif %}{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Return Policy</a>{% endif %}{% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{% endif %}{% endif %}</div>
    <div><h3>Follow Us</h3><p class="nx-footer__social">{% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" aria-label="Instagram">Instagram</a>{% endif %}{% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook">Facebook</a>{% endif %}{% if section.settings.pinterest_url != blank %}<a href="{{ section.settings.pinterest_url }}" aria-label="Pinterest">Pinterest</a>{% endif %}</p></div>
  </div>
</footer>
{% else %}
<footer class="site-footer"><a class="brand" href="{{ routes.root_url }}">{% render 'az-icon', name: 'brand', class: 'brand-mark' %}Aqua<span>Zen</span></a><p>Better hydration for every beautiful day.</p><p class="footer-note">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Made for going further.</p></footer>
{% endif %}
{% schema %}{"name":"Footer","settings":[{"type":"text","id":"home_brand","label":"Homepage brand","default":"Nexora"},{"type":"link_list","id":"information_menu","label":"Information menu"},{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"url","id":"facebook_url","label":"Facebook URL"},{"type":"url","id":"pinterest_url","label":"Pinterest URL"}]}{% endschema %}
