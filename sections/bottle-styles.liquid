<section class="styles"><div class="styles-header"><h2>CHOOSE YOUR STYLE</h2><p>A color for every personality.</p></div><div class="style-grid">{% assign colors = 'Midnight Black,Arctic White,Forest Green,Blush Pink,Ocean Blue' | split: ',' %}{% for color in colors %}<div class="bottle-choice {% if forloop.index == 3 %}selected{% endif %}"><i class="bottle bottle-{{ forloop.index }}"></i><span>{{ color }}</span></div>{% endfor %}</div><aside class="collection-card"><div><h2>More<br>Than A Bottle<br>A Lifestyle</h2><a class="button button--small" href="{{ routes.all_products_collection_url }}">Shop the collection →</a></div></aside></section>
