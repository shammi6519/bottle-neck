<section class="nxc nx-container" aria-labelledby="nxc-title">
  <nav class="nxc-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>Search</span></nav>
  <header class="nxc-page-heading"><p class="nx-kicker">FIND YOUR NEXT FAVORITE</p><h1 id="nxc-title">Search Products</h1></header>
  <form class="nxc-search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="nxc-search-query">Search products</label><input id="nxc-search-query" type="search" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?" required><input type="hidden" name="type" value="product"><button class="nxc-button" type="submit">Search {% render 'az-icon', name: 'search' %}</button></form>
  {% if search.performed %}
    {% paginate search.results by 12 %}
      <div class="nxc-toolbar"><p>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %} for “{{ search.terms | escape }}”</p></div>
      {% if search.results_count > 0 %}<div class="nxc-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'nx-product-card', product: item %}{% endif %}{% endfor %}</div>{% render 'nx-pagination', paginate: paginate %}
      {% else %}<div class="nxc-empty"><h2>No products found</h2><p>Try a different search or browse all products.</p><a class="nxc-button" href="{{ routes.all_products_collection_url }}">Shop All Products {% render 'az-icon', name: 'arrow-right' %}</a></div>{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% schema %}{"name":"Search products","settings":[],"presets":[{"name":"Search products"}]}{% endschema %}
