{% liquid
  assign best_seller = false
  for tag in product.tags
    if tag == 'best-seller' or tag == 'Best Seller' or tag == 'bestseller'
      assign best_seller = true
    endif
  endfor

  assign compare = product.selected_or_first_available_variant.compare_at_price
  assign price = product.selected_or_first_available_variant.price
  assign save_percent = 0
  if compare > price
    assign diff = compare | minus: price
    assign save_percent = diff | times: 100 | divided_by: compare
  endif
%}
<section class="azp" data-section-id="{{ section.id }}">
  <nav class="azp__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span>/</span>
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    <span>/</span>
    <strong>{{ product.title }}</strong>
  </nav>

  <div class="azp__hero">
    <div class="azp__gallery">
      {% if product.media.size > 1 %}
        <div class="azp__thumbs" aria-label="Product images">
          {% for media in product.media %}
            {% assign thumb_alt = media.alt | default: product.title %}
            <button type="button" class="azp__thumb{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" aria-label="Show image {{ forloop.index }}">
              {{ media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', alt: thumb_alt }}
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <div class="azp__stage">
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            {% assign media_alt = media.alt | default: product.title %}
            <figure class="azp__figure{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}">
              {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 46vw, 100vw', widths: '400, 600, 800, 1000, 1200', alt: media_alt }}
            </figure>
          {% endfor %}
        {% else %}
          <figure class="azp__figure is-active azp__placeholder">{{ 'product-1' | placeholder_svg_tag }}</figure>
        {% endif %}
        <button type="button" class="azp__zoom" data-azp-zoom aria-label="View full image">{% render 'az-icon', name: 'search' %}</button>
      </div>
    </div>

    <div class="azp__info">
      {% if best_seller or section.settings.badge_text != blank %}
        <span class="azp__badge">{{ section.settings.badge_text | default: 'Best Seller' }}</span>
      {% endif %}
      <h1>{{ product.title }}</h1>
      {% if section.settings.subtitle != blank %}<p class="azp__subtitle">{{ section.settings.subtitle }}</p>{% endif %}

      <div class="azp__rating">
        <span>
          {% for i in (1..5) %}{% render 'az-icon', name: 'star' %}{% endfor %}
        </span>
        <b>{{ section.settings.rating_value | default: '4.8' }}</b>
        <small>({{ section.settings.review_count | default: '2,548' }} reviews)</small>
      </div>

      <div class="azp__price">
        <strong data-price>{{ price | money }}</strong>
        {% if compare > price %}
          <del data-compare>{{ compare | money }}</del>
          <span class="azp__save" data-save>Save {{ save_percent }}%</span>
        {% else %}
          <del data-compare hidden></del>
          <span class="azp__save" data-save hidden></span>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="azp__feature-pills">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <span class="azp__feature-pill" {{ block.shopify_attributes }}>{% render 'az-icon', name: block.settings.icon %}{{ block.settings.label }}</span>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% form 'product', product, class: 'azp__form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            {% assign option_name_down = option.name | downcase %}
            <div class="azp__option{% if option_name_down contains 'color' or option_name_down contains 'colour' %} azp__option--color{% endif %}" data-option-position="{{ option.position }}">
              <p class="azp__option-label">{{ option.name }}: <span data-option-label="{{ option.position }}">{{ option.selected_value }}</span></p>
              <div class="azp__option-values">
                {% if option_name_down contains 'color' or option_name_down contains 'colour' %}
                  {% for value in option.values %}
                    {% assign input_id = section.id | append: '-azp-' | append: option.position | append: '-' | append: forloop.index %}
                    {% assign value_down = value | downcase %}
                    <label class="azp__swatch" for="{{ input_id }}" title="{{ value }}">
                      <input id="{{ input_id }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                      <span class="azp__swatch-dot" style="--swatch-color:
                        {%- case value_down -%}
                          {%- when 'black', 'jet black', 'onyx' -%}#161616
                          {%- when 'white', 'ivory', 'cream' -%}#f4f2ec
                          {%- when 'grey', 'gray', 'charcoal' -%}#8a8b87
                          {%- when 'green', 'forest', 'forest green', 'olive' -%}#3f5b3f
                          {%- when 'blue', 'navy', 'navy blue' -%}#26415f
                          {%- when 'light blue', 'sky', 'sky blue', 'powder blue' -%}#c3d3e6
                          {%- when 'red', 'maroon', 'burgundy' -%}#7a2a2a
                          {%- when 'pink', 'blush', 'rose' -%}#e2a8ac
                          {%- when 'brown', 'tan', 'cognac', 'chestnut', 'camel' -%}#7a5230
                          {%- when 'beige', 'sand', 'stone' -%}#d8cdb8
                          {%- when 'gold' -%}#b9992f
                          {%- when 'silver' -%}#c7c9cc
                          {%- when 'yellow' -%}#e3c23c
                          {%- when 'orange' -%}#c96a2e
                          {%- when 'purple' -%}#5b4270
                          {%- else -%}#9aa08f
                        {%- endcase -%}
                      "></span>
                    </label>
                  {% endfor %}
                {% else %}
                  {% for value in option.values %}
                    {% assign input_id = section.id | append: '-azp-' | append: option.position | append: '-' | append: forloop.index %}
                    <label class="azp__pill" for="{{ input_id }}">
                      <input id="{{ input_id }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endunless %}

        <div class="azp__buy-row">
          <div class="azp__qty">
            <button type="button" data-qty-minus aria-label="Decrease quantity">{% render 'az-icon', name: 'minus' %}</button>
            <input type="number" name="quantity" value="1" min="1" data-qty-input>
            <button type="button" data-qty-plus aria-label="Increase quantity">{% render 'az-icon', name: 'plus' %}</button>
          </div>
          <button class="azp__cart" type="submit" name="add" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %} data-add-button>
            {% render 'az-icon', name: 'cart' %}<span data-add-text>{% if product.selected_or_first_available_variant.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
          </button>
        </div>
        {{ form | payment_button }}
      {% endform %}

      <div class="azp__trust">
        <span>{% render 'az-icon', name: 'truck' %}<b>{{ section.settings.trust_1_title | default: 'Free Shipping' }}</b><small>{{ section.settings.trust_1_text | default: 'Orders over $50' }}</small></span>
        <span>{% render 'az-icon', name: 'shield' %}<b>{{ section.settings.trust_2_title | default: '30-Day Returns' }}</b><small>{{ section.settings.trust_2_text | default: 'Hassle free' }}</small></span>
        <span>{% render 'az-icon', name: 'leaf' %}<b>{{ section.settings.trust_3_title | default: 'Give Back' }}</b><small>{{ section.settings.trust_3_text | default: 'With every order' }}</small></span>
      </div>
    </div>
  </div>

  {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}
  {% if benefit_blocks.size > 0 %}
    <div class="azp__benefits">
      {% for block in benefit_blocks %}
        <div class="azp__benefit" {{ block.shopify_attributes }}>
          {% render 'az-icon', name: block.settings.icon %}
          <b>{{ block.settings.title }}</b>
          <span>{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  <div class="azp__tabs" data-azp-tabs>
    <div class="azp__tabs-nav" role="tablist">
      <button type="button" class="is-active" data-tab-target="description" role="tab">Description</button>
      <button type="button" data-tab-target="specs" role="tab">Specifications</button>
      <button type="button" data-tab-target="shipping" role="tab">Shipping & Returns</button>
      <button type="button" data-tab-target="reviews" role="tab">Reviews ({{ section.settings.review_count | default: '2,548' }})</button>
      <button type="button" data-tab-target="care" role="tab">Care Guide</button>
    </div>

    <div class="azp__tabs-panels">
      <div class="azp__panel is-active" data-tab-panel="description">
        <div class="azp__story">
          <div class="azp__story-copy">
            <h2>{{ section.settings.story_heading | default: 'Made to Last, Built for Life' }}</h2>
            <div class="azp__description">{{ product.description | default: section.settings.fallback_description }}</div>
            {% if section.settings.story_points != blank %}
              {% assign story_point_lines = section.settings.story_points | split: newline %}
              <ul class="azp__checklist">
                {% for line in story_point_lines %}
                  {% if line != blank %}<li>{% render 'az-icon', name: 'check' %}{{ line }}</li>{% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
          <div class="azp__story-media">
            {% if section.settings.story_image %}
              {{ section.settings.story_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', alt: section.settings.story_heading }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}
            <div class="azp__story-caption">
              <p>{{ section.settings.story_caption | default: 'More Than a Product<br>A Better Everyday' }}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="azp__panel" data-tab-panel="specs">
        <dl class="azp__specs">
          <div><dt>Product</dt><dd>{{ product.title }}</dd></div>
          {% if product.vendor != blank %}<div><dt>Brand</dt><dd>{{ product.vendor }}</dd></div>{% endif %}
          {% if product.type != blank %}<div><dt>Category</dt><dd>{{ product.type }}</dd></div>{% endif %}
          <div><dt>Options</dt><dd>{% unless product.has_only_default_variant %}{{ product.options | join: ', ' }}{% else %}Single option{% endunless %}</dd></div>
          <div><dt>SKU</dt><dd data-spec-sku>{{ product.selected_or_first_available_variant.sku | default: 'Not assigned' }}</dd></div>
          <div><dt>Inventory</dt><dd data-spec-stock>{% if product.selected_or_first_available_variant.available %}Available{% else %}Sold out{% endif %}</dd></div>
          {% if product.tags.size > 0 %}<div><dt>Tags</dt><dd>{{ product.tags | join: ', ' }}</dd></div>{% endif %}
        </dl>
      </div>

      <div class="azp__panel" data-tab-panel="shipping">
        <div class="azp__richtext">{{ section.settings.shipping_text }}</div>
      </div>

      <div class="azp__panel" data-tab-panel="reviews">
        <div class="azp__reviews-summary">
          <strong>{{ section.settings.rating_value | default: '4.8' }}</strong>
          <span>{% for i in (1..5) %}{% render 'az-icon', name: 'star' %}{% endfor %}</span>
          <p>Based on {{ section.settings.review_count | default: '2,548' }} reviews</p>
        </div>
      </div>

      <div class="azp__panel" data-tab-panel="care">
        <div class="azp__richtext">{{ section.settings.care_text }}</div>
      </div>
    </div>
  </div>

  {% assign lifestyle_blocks = section.blocks | where: 'type', 'lifestyle' %}
  {% if lifestyle_blocks.size > 0 %}
    <div class="azp__lifestyle">
      {% for block in lifestyle_blocks %}
        <div class="azp__lifestyle-tile" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', alt: block.settings.label }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}
          <span>{{ block.settings.label }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {% assign related_collection = product.collections.first %}
  {% if related_collection %}
    <div class="azp__related">
      <div class="azp__related-head">
        <h2>{{ section.settings.related_heading | default: 'You May Also Like' }}</h2>
        <a href="{{ related_collection.url }}">View All {% render 'az-icon', name: 'arrow-right' %}</a>
      </div>
      <div class="azp__related-grid">
        {% assign shown = 0 %}
        {% for related in related_collection.products %}
          {% if related.id != product.id and shown < 4 %}
            {% assign shown = shown | plus: 1 %}
            <a class="azp__related-card" href="{{ related.url }}">
              <div class="azp__related-image">
                {% if related.featured_media %}
                  {{ related.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', alt: related.title }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <b>{{ related.title }}</b>
              <span>{{ related.price | money }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="azp__lightbox" data-azp-lightbox hidden>
    <button type="button" class="azp__lightbox-close" data-azp-lightbox-close aria-label="Close">{% render 'az-icon', name: 'x' %}</button>
    <img data-azp-lightbox-image src="" alt="">
  </div>

  <script type="application/json" data-product-json>{{ product.variants | json }}</script>
  <script>
    (() => {
      const root = document.currentScript.closest('.azp');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = 'true';
      const moneyFormat = {{ shop.money_format | json }};
      const variants = JSON.parse(root.querySelector('[data-product-json]').textContent || '[]');
      const formatMoney = cents => {
        if (window.Shopify && Shopify.formatMoney) return Shopify.formatMoney(cents, moneyFormat);
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: {{ cart.currency.iso_code | json }} }).format(cents / 100);
      };

      const showMedia = id => {
        if (!id) return;
        root.querySelectorAll('[data-media-id]').forEach(el => el.classList.toggle('is-active', String(el.dataset.mediaId) === String(id)));
      };
      root.querySelectorAll('.azp__thumb').forEach(btn => btn.addEventListener('click', () => showMedia(btn.dataset.mediaId)));

      const getOptions = () => [...root.querySelectorAll('.azp__option')].map(group => {
        const checked = group.querySelector('input:checked');
        return checked ? checked.value : '';
      });

      const syncVariant = () => {
        const chosen = getOptions();
        const variant = variants.find(item => item.options.every((option, index) => option === chosen[index])) || variants[0];
        if (!variant) return;
        root.querySelector('[data-variant-id]').value = variant.id;
        root.querySelector('[data-price]').textContent = formatMoney(variant.price);
        const compare = root.querySelector('[data-compare]');
        const save = root.querySelector('[data-save]');
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compare.hidden = false;
          compare.textContent = formatMoney(variant.compare_at_price);
          save.hidden = false;
          save.textContent = 'Save ' + Math.round(((variant.compare_at_price - variant.price) / variant.compare_at_price) * 100) + '%';
        } else {
          compare.hidden = true;
          compare.textContent = '';
          save.hidden = true;
          save.textContent = '';
        }
        const addButton = root.querySelector('[data-add-button]');
        const addText = root.querySelector('[data-add-text]');
        addButton.disabled = !variant.available;
        addText.textContent = variant.available ? 'Add to Cart' : 'Sold Out';
        const sku = root.querySelector('[data-spec-sku]');
        if (sku) sku.textContent = variant.sku || 'Not assigned';
        const stock = root.querySelector('[data-spec-stock]');
        if (stock) stock.textContent = variant.available ? 'Available' : 'Sold out';
        if (variant.featured_media && variant.featured_media.id) showMedia(variant.featured_media.id);
      };
      root.querySelectorAll('.azp__option input').forEach(input => input.addEventListener('change', event => {
        const group = event.target.closest('.azp__option');
        const label = root.querySelector('[data-option-label="' + group.dataset.optionPosition + '"]');
        if (label) label.textContent = event.target.value;
        syncVariant();
      }));

      const qtyInput = root.querySelector('[data-qty-input]');
      root.querySelector('[data-qty-minus]')?.addEventListener('click', () => {
        qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
      });
      root.querySelector('[data-qty-plus]')?.addEventListener('click', () => {
        qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
      });

      const tabs = root.querySelector('[data-azp-tabs]');
      if (tabs) {
        tabs.querySelectorAll('[data-tab-target]').forEach(btn => {
          btn.addEventListener('click', () => {
            tabs.querySelectorAll('[data-tab-target]').forEach(b => b.classList.toggle('is-active', b === btn));
            tabs.querySelectorAll('[data-tab-panel]').forEach(panel => panel.classList.toggle('is-active', panel.dataset.tabPanel === btn.dataset.tabTarget));
          });
        });
      }

      const lightbox = root.querySelector('[data-azp-lightbox]');
      const lightboxImage = root.querySelector('[data-azp-lightbox-image]');
      root.querySelector('[data-azp-zoom]')?.addEventListener('click', () => {
        const active = root.querySelector('.azp__figure.is-active img');
        if (!active || !lightbox) return;
        lightboxImage.src = active.currentSrc || active.src;
        lightboxImage.alt = active.alt;
        lightbox.hidden = false;
      });
      root.querySelector('[data-azp-lightbox-close]')?.addEventListener('click', () => { lightbox.hidden = true; });
      lightbox?.addEventListener('click', event => { if (event.target === lightbox) lightbox.hidden = true; });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Premium product page",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text", "info": "Leave blank to auto-detect the 'best-seller' tag", "default": "Best Seller" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Made for everyday use, wherever life takes you." },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "2,548" },
    { "type": "header", "content": "Trust row" },
    { "type": "text", "id": "trust_1_title", "label": "Trust 1 title", "default": "Free Shipping" },
    { "type": "text", "id": "trust_1_text", "label": "Trust 1 subtext", "default": "Orders over $50" },
    { "type": "text", "id": "trust_2_title", "label": "Trust 2 title", "default": "30-Day Returns" },
    { "type": "text", "id": "trust_2_text", "label": "Trust 2 subtext", "default": "Hassle free" },
    { "type": "text", "id": "trust_3_title", "label": "Trust 3 title", "default": "Give Back" },
    { "type": "text", "id": "trust_3_text", "label": "Trust 3 subtext", "default": "With every order" },
    { "type": "header", "content": "Story section" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "Made to Last, Built for Life" },
    { "type": "richtext", "id": "fallback_description", "label": "Fallback description", "default": "<p>This product is designed for everyday use with a focus on quality, comfort, and dependable performance.</p>" },
    { "type": "textarea", "id": "story_points", "label": "Checklist points", "info": "One per line", "default": "Premium materials\nCrafted for daily wear\nEasy to clean and maintain\nBacked by our guarantee" },
    { "type": "image_picker", "id": "story_image", "label": "Story image" },
    { "type": "text", "id": "story_caption", "label": "Story image caption", "default": "More Than a Product<br>A Better Everyday" },
    { "type": "header", "content": "Tab content" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping & returns text", "default": "<p>Orders are processed quickly and shipped with tracking. Return eligible items within 30 days in unused condition.</p>" },
    { "type": "richtext", "id": "care_text", "label": "Care guide text", "default": "<p>Keep the product clean and dry. Follow any product-specific instructions included with your order.</p>" },
    { "type": "header", "content": "Related products" },
    { "type": "text", "id": "related_heading", "label": "Related heading", "default": "You May Also Like" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature pill",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "snowflake", "label": "Snowflake" },
          { "value": "flame", "label": "Flame" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "diamond", "label": "Diamond" },
          { "value": "shield", "label": "Shield" },
          { "value": "heart", "label": "Heart" },
          { "value": "check", "label": "Check" }
        ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Premium Quality" }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
          { "value": "leaf", "label": "Leaf" },
          { "value": "diamond", "label": "Diamond" },
          { "value": "star", "label": "Star" },
          { "value": "heart", "label": "Heart" },
          { "value": "shield", "label": "Shield" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Sustainable Choice" },
        { "type": "text", "id": "text", "label": "Text", "default": "Better for you. Better for the planet." }
      ]
    },
    {
      "type": "lifestyle",
      "name": "Lifestyle tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "For Everyday Life" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium product page",
      "blocks": [
        { "type": "feature", "settings": { "icon": "snowflake", "label": "24H Cold" } },
        { "type": "feature", "settings": { "icon": "flame", "label": "12H Hot" } },
        { "type": "feature", "settings": { "icon": "leaf", "label": "BPA Free" } },
        { "type": "feature", "settings": { "icon": "diamond", "label": "Premium Quality" } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Sustainable Choice", "text": "Better for you. Better for the planet." } },
        { "type": "benefit", "settings": { "icon": "diamond", "title": "Built to Last", "text": "Premium, long-lasting materials." } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Stylish & Functional", "text": "Designed for everyday life." } },
        { "type": "benefit", "settings": { "icon": "heart", "title": "Loved by Thousands", "text": "Over 100,000+ happy customers." } }
      ]
    }
  ]
}
{% endschema %}
