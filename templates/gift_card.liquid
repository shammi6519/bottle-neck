{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name | escape }} gift card</title>
    {{ content_for_header }}
    <style>
      *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#f4f2ef;color:#171819;font-family:Arial,sans-serif}.gift-card{width:min(100%,500px);background:#fff;border:1px solid #e6e3df;border-radius:8px;padding:40px;box-shadow:0 18px 50px #0000000d}.gift-card__brand{font-size:24px;font-weight:700;letter-spacing:-1px;text-decoration:none;color:inherit}.gift-card__eyebrow{margin:45px 0 9px;font-size:11px;letter-spacing:2px;text-transform:uppercase}.gift-card h1{margin:0 0 10px;font-size:37px;font-weight:500;line-height:1.1}.gift-card__balance{margin:0 0 34px;font-size:16px;color:#555}.gift-card__code{display:block;width:100%;border:1px dashed #aaa;border-radius:4px;background:#f8f8f8;padding:16px;overflow-wrap:anywhere;text-align:center;font-size:20px;letter-spacing:2px;font-weight:700}.gift-card__hint,.gift-card__expiry{font-size:12px;color:#666;line-height:1.5}.gift-card__shop{display:inline-block;margin-top:24px;padding:13px 20px;border-radius:3px;background:#171819;color:#fff;text-decoration:none;font-size:13px;font-weight:700}@media(max-width:560px){.gift-card{padding:28px}.gift-card h1{font-size:30px}}
    </style>
  </head>
  <body>
    <main class="gift-card">
      <a class="gift-card__brand" href="{{ shop.url }}">{{ shop.name | escape }}</a>
      <p class="gift-card__eyebrow">A gift for you</p>
      <h1>Gift card</h1>
      <p class="gift-card__balance">Balance: {{ gift_card.balance | money }}</p>
      <div class="gift-card__code" aria-label="Gift card code">{{ gift_card.code | escape }}</div>
      <p class="gift-card__hint">Enter this code at checkout to use your gift card.</p>
      {% if gift_card.expires_on %}<p class="gift-card__expiry">Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>{% endif %}
      <a class="gift-card__shop" href="{{ shop.url }}">Shop now</a>
    </main>
  </body>
</html>
